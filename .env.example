# Environment template for local Edge Hub (Phase 0).
# Copy to services/edge-api/.env as needed.

VL_ENV=development
VL_DEBUG=false
VL_LOG_LEVEL=INFO
VL_HOST=0.0.0.0
VL_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/visionlayer.db
VL_JWT_SECRET=visionlayer-dev-secret-change-me-32b
VL_ADMIN_USERNAME=admin
VL_ADMIN_PASSWORD=admin123
VL_SEED_DEMO=true

FEATURE_SIMULATE_DETECTIONS=true
FEATURE_VIDEO_LAB=true
FEATURE_LIVE_VIDEO=false
FEATURE_WEB_PUSH=false
FEATURE_CLOUD_SYNC=false
FEATURE_SKILLS=false
FEATURE_NATURAL_LANGUAGE_RULES=false
FEATURE_SEMANTIC_SEARCH=false
FEATURE_ONVIF_DISCOVERY=false
