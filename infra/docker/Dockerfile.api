FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VL_SHARED_ROOT=/shared

COPY services/edge-api/pyproject.toml /app/pyproject.toml
COPY services/edge-api/app /app/app
COPY services/edge-api/alembic /app/alembic
COPY services/edge-api/alembic.ini /app/alembic.ini
COPY shared /shared

RUN pip install --no-cache-dir .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
